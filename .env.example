# Copy this file to .env and fill in your API keys
# Then run: source .env

# Required: at least one LLM provider
export OPENAI_API_KEY=sk-...
export ANTHROPIC_API_KEY=sk-ant-...
export GEMINI_API_KEY=AIza...
export DEEPSEEK_API_KEY=sk-...
export GLM_API_KEY=...
export KIMI_API_KEY=sk-...

# External tools (auto-detected if in sibling dirs, otherwise set paths) — see CHASE_INSTALL_MACOS.md
export NUXMV=/path/to/nuxmv/bin/nuxmv
export SLUGS=/path/to/slugs/src/slugs
export SLUGS_COMP=/path/to/slugs/tools/StructuredSlugsParser/compiler.py
export LOGICS_TOOL=/path/to/chase/bin/logics_tool

# CHASE runtime library path
export DYLD_LIBRARY_PATH=/path/to/third_party/antlr4/lib:${DYLD_LIBRARY_PATH:-}
