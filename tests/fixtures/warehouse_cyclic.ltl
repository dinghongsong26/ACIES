NAME: warehouse;

CONTRACT Robot1:
    input boolean variable r1_at_shelf;
    input boolean variable r1_at_dock;
    input boolean variable r1_has_item;
    input boolean variable r1_shelf_granted;
    input boolean variable r1_dock_granted;
    input boolean variable task_pending;
    output boolean variable r1_nav_shelf;
    output boolean variable r1_nav_dock;
    output boolean variable r1_pickup;
    output boolean variable r1_dropoff;
    output boolean variable r1_req_shelf;
    output boolean variable r1_req_dock;
    Assumptions:
        !r1_at_shelf;
        !r1_at_dock;
        !r1_has_item;
        !task_pending;
        G F(r1_at_shelf | !r1_nav_shelf);
        G F(r1_at_dock | !r1_nav_dock);
        G(r1_at_shelf & !r1_nav_dock -> X(r1_at_shelf));
        G(!r1_at_shelf & !r1_nav_shelf -> X(!r1_at_shelf));
        G(r1_at_dock & !r1_nav_shelf -> X(r1_at_dock));
        G(!r1_at_dock & !r1_nav_dock -> X(!r1_at_dock));
        G(r1_has_item & !r1_dropoff -> X(r1_has_item));
        G(!r1_has_item & !r1_pickup -> X(!r1_has_item));
        G F(r1_shelf_granted | !r1_req_shelf);
        G F(r1_dock_granted | !r1_req_dock);
        G F(task_pending);
    Guarantees:
        !r1_nav_shelf;
        !r1_nav_dock;
        !r1_pickup;
        !r1_dropoff;
        !r1_req_shelf;
        !r1_req_dock;
        G(r1_nav_shelf | r1_pickup -> r1_shelf_granted);
        G(r1_nav_dock | r1_dropoff -> r1_dock_granted);
        G(r1_pickup -> r1_at_shelf);
        G(r1_dropoff -> (r1_at_dock & r1_has_item));
        G(!(r1_nav_shelf & r1_nav_dock) & !(r1_pickup & r1_dropoff) & !(r1_nav_shelf & r1_pickup) & !(r1_nav_dock & r1_dropoff) & !(r1_nav_shelf & r1_dropoff) & !(r1_nav_dock & r1_pickup));
        G(r1_nav_shelf & !r1_at_shelf -> X(r1_nav_shelf));
        G(r1_nav_dock & !r1_at_dock -> X(r1_nav_dock));
        G(r1_req_shelf & !r1_shelf_granted -> X(r1_req_shelf));
        G(r1_req_dock & !r1_dock_granted -> X(r1_req_dock));
        G F(r1_dropoff);
        G F(!r1_req_shelf);
        G F(!r1_req_dock);

CONTRACT Robot2:
    input boolean variable r2_at_shelf;
    input boolean variable r2_at_dock;
    input boolean variable r2_has_item;
    input boolean variable r2_shelf_granted;
    input boolean variable r2_dock_granted;
    input boolean variable task_pending;
    output boolean variable r2_nav_shelf;
    output boolean variable r2_nav_dock;
    output boolean variable r2_pickup;
    output boolean variable r2_dropoff;
    output boolean variable r2_req_shelf;
    output boolean variable r2_req_dock;
    Assumptions:
        !r2_at_shelf;
        !r2_at_dock;
        !r2_has_item;
        !task_pending;
        G F(r2_at_shelf | !r2_nav_shelf);
        G F(r2_at_dock | !r2_nav_dock);
        G(r2_at_shelf & !r2_nav_dock -> X(r2_at_shelf));
        G(!r2_at_shelf & !r2_nav_shelf -> X(!r2_at_shelf));
        G(r2_at_dock & !r2_nav_shelf -> X(r2_at_dock));
        G(!r2_at_dock & !r2_nav_dock -> X(!r2_at_dock));
        G(r2_has_item & !r2_dropoff -> X(r2_has_item));
        G(!r2_has_item & !r2_pickup -> X(!r2_has_item));
        G F(r2_shelf_granted | !r2_req_shelf);
        G F(r2_dock_granted | !r2_req_dock);
        G F(task_pending);
    Guarantees:
        !r2_nav_shelf;
        !r2_nav_dock;
        !r2_pickup;
        !r2_dropoff;
        !r2_req_shelf;
        !r2_req_dock;
        G(r2_nav_shelf | r2_pickup -> r2_shelf_granted);
        G(r2_nav_dock | r2_dropoff -> r2_dock_granted);
        G(r2_pickup -> r2_at_shelf);
        G(r2_dropoff -> (r2_at_dock & r2_has_item));
        G(!(r2_nav_shelf & r2_nav_dock) & !(r2_pickup & r2_dropoff) & !(r2_nav_shelf & r2_pickup) & !(r2_nav_dock & r2_dropoff) & !(r2_nav_shelf & r2_dropoff) & !(r2_nav_dock & r2_pickup));
        G(r2_nav_shelf & !r2_at_shelf -> X(r2_nav_shelf));
        G(r2_nav_dock & !r2_at_dock -> X(r2_nav_dock));
        G(r2_req_shelf & !r2_shelf_granted -> X(r2_req_shelf));
        G(r2_req_dock & !r2_dock_granted -> X(r2_req_dock));
        G F(r2_dropoff);
        G F(!r2_req_shelf);
        G F(!r2_req_dock);

CONTRACT Arbiter:
    input boolean variable r1_req_shelf;
    input boolean variable r1_req_dock;
    input boolean variable r2_req_shelf;
    input boolean variable r2_req_dock;
    output boolean variable r1_shelf_granted;
    output boolean variable r1_dock_granted;
    output boolean variable r2_shelf_granted;
    output boolean variable r2_dock_granted;
    Assumptions:
        G F(!r1_req_shelf);
        G F(!r1_req_dock);
        G F(!r2_req_shelf);
        G F(!r2_req_dock);
    Guarantees:
        !r1_shelf_granted;
        !r1_dock_granted;
        !r2_shelf_granted;
        !r2_dock_granted;
        G(!(r1_shelf_granted & r2_shelf_granted));
        G(!(r1_dock_granted & r2_dock_granted));
        G(r1_shelf_granted -> r1_req_shelf);
        G(r1_dock_granted -> r1_req_dock);
        G(r2_shelf_granted -> r2_req_shelf);
        G(r2_dock_granted -> r2_req_dock);
        G F(r1_shelf_granted | !r1_req_shelf);
        G F(r1_dock_granted | !r1_req_dock);
        G F(r2_shelf_granted | !r2_req_shelf);
        G F(r2_dock_granted | !r2_req_dock);

CONTRACT System:
    input boolean variable r1_at_shelf;
    input boolean variable r1_at_dock;
    input boolean variable r1_has_item;
    input boolean variable r2_at_shelf;
    input boolean variable r2_at_dock;
    input boolean variable r2_has_item;
    input boolean variable task_pending;
    output boolean variable r1_nav_shelf;
    output boolean variable r1_nav_dock;
    output boolean variable r1_pickup;
    output boolean variable r1_dropoff;
    output boolean variable r1_req_shelf;
    output boolean variable r1_req_dock;
    output boolean variable r2_nav_shelf;
    output boolean variable r2_nav_dock;
    output boolean variable r2_pickup;
    output boolean variable r2_dropoff;
    output boolean variable r2_req_shelf;
    output boolean variable r2_req_dock;
    output boolean variable r1_shelf_granted;
    output boolean variable r1_dock_granted;
    output boolean variable r2_shelf_granted;
    output boolean variable r2_dock_granted;
    Assumptions:
        !r1_at_shelf;
        !r1_at_dock;
        !r1_has_item;
        !r2_at_shelf;
        !r2_at_dock;
        !r2_has_item;
        !task_pending;
        G F(r1_at_shelf | !r1_nav_shelf);
        G F(r1_at_dock | !r1_nav_dock);
        G F(r2_at_shelf | !r2_nav_shelf);
        G F(r2_at_dock | !r2_nav_dock);
        G F(task_pending);
        G(r1_at_shelf & !r1_nav_dock -> X(r1_at_shelf));
        G(!r1_at_shelf & !r1_nav_shelf -> X(!r1_at_shelf));
        G(r1_at_dock & !r1_nav_shelf -> X(r1_at_dock));
        G(!r1_at_dock & !r1_nav_dock -> X(!r1_at_dock));
        G(r1_has_item & !r1_dropoff -> X(r1_has_item));
        G(!r1_has_item & !r1_pickup -> X(!r1_has_item));
        G(r2_at_shelf & !r2_nav_dock -> X(r2_at_shelf));
        G(!r2_at_shelf & !r2_nav_shelf -> X(!r2_at_shelf));
        G(r2_at_dock & !r2_nav_shelf -> X(r2_at_dock));
        G(!r2_at_dock & !r2_nav_dock -> X(!r2_at_dock));
        G(r2_has_item & !r2_dropoff -> X(r2_has_item));
        G(!r2_has_item & !r2_pickup -> X(!r2_has_item));
    Guarantees:
        !r1_nav_shelf;
        !r1_nav_dock;
        !r1_pickup;
        !r1_dropoff;
        !r1_req_shelf;
        !r1_req_dock;
        !r2_nav_shelf;
        !r2_nav_dock;
        !r2_pickup;
        !r2_dropoff;
        !r2_req_shelf;
        !r2_req_dock;
        !r1_shelf_granted;
        !r1_dock_granted;
        !r2_shelf_granted;
        !r2_dock_granted;
        G F(r1_dropoff);
        G F(r2_dropoff);
        G(!(r1_shelf_granted & r2_shelf_granted));
        G(!(r1_dock_granted & r2_dock_granted));
        G(r1_nav_shelf | r1_pickup -> r1_shelf_granted);
        G(r1_nav_dock | r1_dropoff -> r1_dock_granted);
        G(r2_nav_shelf | r2_pickup -> r2_shelf_granted);
        G(r2_nav_dock | r2_dropoff -> r2_dock_granted);
        G(r1_pickup -> r1_at_shelf);
        G(r1_dropoff -> (r1_at_dock & r1_has_item));
        G(r2_pickup -> r2_at_shelf);
        G(r2_dropoff -> (r2_at_dock & r2_has_item));
        G(!(r1_nav_shelf & r1_nav_dock) & !(r1_pickup & r1_dropoff) & !(r1_nav_shelf & r1_pickup) & !(r1_nav_dock & r1_dropoff) & !(r1_nav_shelf & r1_dropoff) & !(r1_nav_dock & r1_pickup));
        G(!(r2_nav_shelf & r2_nav_dock) & !(r2_pickup & r2_dropoff) & !(r2_nav_shelf & r2_pickup) & !(r2_nav_dock & r2_dropoff) & !(r2_nav_shelf & r2_dropoff) & !(r2_nav_dock & r2_pickup));
        G(r1_nav_shelf & !r1_at_shelf -> X(r1_nav_shelf));
        G(r1_nav_dock & !r1_at_dock -> X(r1_nav_dock));
        G(r2_nav_shelf & !r2_at_shelf -> X(r2_nav_shelf));
        G(r2_nav_dock & !r2_at_dock -> X(r2_nav_dock));
        G(r1_req_shelf & !r1_shelf_granted -> X(r1_req_shelf));
        G(r1_req_dock & !r1_dock_granted -> X(r1_req_dock));
        G(r2_req_shelf & !r2_shelf_granted -> X(r2_req_shelf));
        G(r2_req_dock & !r2_dock_granted -> X(r2_req_dock));
        G(r1_shelf_granted -> r1_req_shelf);
        G(r1_dock_granted -> r1_req_dock);
        G(r2_shelf_granted -> r2_req_shelf);
        G(r2_dock_granted -> r2_req_dock);
        G F(r1_shelf_granted | !r1_req_shelf);
        G F(r1_dock_granted | !r1_req_dock);
        G F(r2_shelf_granted | !r2_req_shelf);
        G F(r2_dock_granted | !r2_req_dock);
